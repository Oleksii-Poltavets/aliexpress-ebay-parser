# RapidAPI Configuration
# Get your API key from: https://rapidapi.com/
# You're using: Aliexpress DataHub API
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=aliexpress-datahub.p.rapidapi.com

# eBay API Configuration
# Get your credentials from: https://developer.ebay.com/
EBAY_APP_ID=your_ebay_app_id_here
EBAY_CERT_ID=your_ebay_cert_id_here
EBAY_DEV_ID=your_ebay_dev_id_here
EBAY_ENVIRONMENT=PRODUCTION

# Optional: Rate limiting (requests per second)
MAX_REQUESTS_PER_SECOND=1

# Google Sheets Configuration
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1CcEmBFjluUtm18JuIzBJTzrHAWoocA7gMsbr_fEjrp8/edit?gid=1636327865#gid=1636327865
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Gemini Configuration (optional, rewrites description before uploading to Google Sheet)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PROMPT_FILE=title_prompt.txt
